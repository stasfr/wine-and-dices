{
  "name": "wine-and-dices",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for Wine-and-dices project",
  "keywords": [],
  "license": "ISC",
  "author": "stas_fr",
  "scripts": {
    "dev:web": "pnpm --filter @wine-and-dices/web dev",
    "dev:backend": "pnpm --filter @wine-and-dices/backend dev",
    "dev": "pnpm --parallel dev",
    "build": "pnpm -r build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "oxfmt": "^0.36.0",
    "oxlint": "^1.51.0",
    "oxlint-tsgolint": "^0.15.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.30.1"
}
